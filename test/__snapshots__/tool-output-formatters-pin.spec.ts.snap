exports[`formatSupplyChain pins > renders every branch exactly [compact] 1`] = `
{
  "allTrustLevels": "Supply Chain: sc.example — 4 providers (1 critical, 1 high, 1 medium, 1 low)
- [CRITICAL] Prov A: mail, dns
- [HIGH] Prov B: mail, dns
- [MEDIUM] Prov C: mail, dns
- [LOW] Prov D: mail, dns

Signals:
- [HIGH] High signal.
- [MEDIUM] Medium signal.
- [LOW] Low signal.
- [INFO] Info signal.",
  "depsWithUnmeasured": "Supply Chain: sc.example — 1 providers (0 critical, 1 high, 0 medium, 0 low)
- [HIGH] Prov A: mail, dns
Not measured: txt, ns lookups did not conclude; dependencies from these sources are unknown.",
  "emptyClean": "Supply Chain: clean.example — 0 providers (0 critical, 0 high, 0 medium, 0 low)",
  "emptyUnmeasured": "Supply Chain: empty.example — 0 providers (0 critical, 0 high, 0 medium, 0 low)
Not measured: mx lookups did not conclude; dependencies from these sources are unknown.

Signals:
- [INFO] CAA forbids issuance.",
  "emptyUnmeasuredList": "Supply Chain: emptylist.example — 0 providers (0 critical, 0 high, 0 medium, 0 low)",
}
`;

