#!/usr/bin/env bash
# Pre-commit hook: block sensitive paths, scan for secrets/PII, catch IP leakage patterns
set -euo pipefail

# ──�� 1. Blocked paths ──────────────────────────────���─────────────────
BLOCKED_PATTERNS=(
  "docs/plans/"
  "docs/code-review/"
  "docs/superpowers/"
  "docs/github-settings.md"
  "docs/hn-show-post-draft.md"
  "docs/mcp-directory-submissions.md"
  "docs/enterprise-architecture.md"
  ".dev/"
  ".dev.vars"
  ".dev.vars."
  ".worktrees/"
  ".mcp-registry-key.pem"
  ".npmrc"
  "wrangler.production.jsonc"
  "reports/"
  ".reports/"
  "reports"
  ".reports"
  "*.pdf"
  "*.env"
  "*.env.*"
  "*.sqlite"
  "*.sqlite3"
  "*.db"
  "scripts/tranco-*.json"
  "reports/tenant-readiness-proof.html"
  "reports/tenant-calibration-*.json"
  "reports/tenant-*.json"
  "reports/repo-audit-*.html"
)

# Generated/compiled files that must never be committed
GENERATED_PATTERNS=(
  "*.pyc"
  "__pycache__/"
  "worker-configuration.d.ts"
  "*.wasm"
  "*.sqlite"
  "*.sqlite3"
  "*.db"
)

staged=$(git diff --cached --name-only --diff-filter=ACR)
blocked=""

for file in $staged; do
  for pattern in "${BLOCKED_PATTERNS[@]}"; do
    case "$file" in
      $pattern*|*/$pattern*)
        blocked="$blocked\n  $file"
        ;;
    esac
  done
done

if [ -n "$blocked" ]; then
  echo "BLOCKED: The following staged files are in protected paths:"
  echo -e "$blocked"
  echo ""
  echo "These paths contain sensitive content and must not be committed."
  echo "If this is intentional, use: git commit --no-verify"
  exit 1
fi

# ─── 1b. Generated/compiled files ────────────────────────────────────
generated=""
for file in $staged; do
  for pattern in "${GENERATED_PATTERNS[@]}"; do
    case "$file" in
      $pattern|*/$pattern|*.$pattern)
        generated="$generated\n  $file"
        ;;
    esac
    # Also check by extension for glob patterns like *.pyc
    case "$pattern" in
      \*.*)
        ext="${pattern#\*}"
        case "$file" in
          *"$ext")
            generated="$generated\n  $file"
            ;;
        esac
        ;;
    esac
  done
done

# Deduplicate
if [ -n "$generated" ]; then
  generated=$(echo -e "$generated" | sort -u)
  echo "BLOCKED: Generated/compiled files should not be committed:"
  echo -e "$generated"
  echo ""
  echo "These are build artifacts. Add them to .gitignore instead."
  echo "To remove from staging: git restore --staged <file>"
  exit 1
fi

# ─── 1c. Symlinks — default-deny any staged symlink (mode 120000) ────
# Reads the STAGED INDEX (git diff --cached --raw), not the working tree or
# .gitignore, so `git add -f` cannot bypass it — `git add -f` is exactly how
# a symlink slips past .gitignore, which is how the node_modules symlink
# incident (#576) reached main: it resolved to a DIFFERENT checkout's
# node_modules, so that session's tests silently validated the wrong code.
# Allowlist starts EMPTY: there are currently zero tracked symlinks in this
# repo (verified via `git ls-tree -r origin/main | grep '^120000'`), so this
# costs nothing today. Add an entry only with an explicit, reviewed reason.
SYMLINK_ALLOWLIST=(
  # Intentionally empty — see comment above.
)

staged_symlinks=$(git diff --cached --raw --diff-filter=ACMRT | awk '$2 == "120000" { print $NF }')
symlink_blocked=""

for file in $staged_symlinks; do
  allowed=0
  if [ "${#SYMLINK_ALLOWLIST[@]}" -gt 0 ]; then
    for allow in "${SYMLINK_ALLOWLIST[@]}"; do
      if [ "$file" = "$allow" ]; then
        allowed=1
        break
      fi
    done
  fi
  if [ "$allowed" -eq 0 ]; then
    symlink_blocked="$symlink_blocked\n  $file"
  fi
done

if [ -n "$symlink_blocked" ]; then
  echo "BLOCKED: The following staged entries are symlinks (git mode 120000):"
  echo -e "$symlink_blocked"
  echo ""
  echo "Tracked symlinks are disallowed by default. A committed symlink"
  echo "resolves to whatever happens to exist at its target path on the"
  echo "machine/checkout that reads it — dangling on most clones, or worse,"
  echo "silently resolving to the WRONG thing (the node_modules symlink"
  echo "incident, #576, pointed one session's node_modules at a different"
  echo "checkout's installed packages, corrupting that session's test"
  echo "results without any error)."
  echo ""
  echo "If you symlinked node_modules to skip a slow per-worktree install,"
  echo "use scripts/worktree-setup.sh instead — it runs the real"
  echo "'npm ci --ignore-scripts' + dns-checks build for you."
  echo ""
  echo "If a tracked symlink is genuinely required, add its path to the"
  echo "SYMLINK_ALLOWLIST array in .githooks/pre-commit with a reason."
  echo "To bypass (reviewed false positive only): git commit --no-verify"
  exit 1
fi

# ─── 2. Gitleaks (secrets + PII) ──────���──────────────────────────────
if command -v gitleaks &>/dev/null; then
  gitleaks protect --staged --config .gitleaks.toml --redact=100 --no-banner 2>&1 | head -20
  if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    echo ""
    echo "Gitleaks found secrets or PII in staged changes."
    echo "Fix the findings above, or bypass with: git commit --no-verify"
    exit 1
  fi
fi

# ─── 2b. Repo safety scanner ─────────────────────────────────────────
node scripts/repo-safety/scan-sensitive-surface.mjs
