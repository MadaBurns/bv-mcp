		"deploy:staged": "cf workers versions create --mode production",
		"deploy:triggers": "cf workers triggers deploy --mode production"
	},
	"devDependencies": {
		"cf": "1.0.0-beta.9",
		"wrangler": "4.142.0"
	}
}
