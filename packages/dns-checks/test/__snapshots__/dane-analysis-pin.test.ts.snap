exports[`analyzeTlsaRecords output pin > mismatch verdict (high, measured defect) > DANE-TA mismatch across every retained chain entry 1`] = `
[
  {
    "category": "dane",
    "detail": "The TLSA association published at mail.example.com was compared against the certificate mail.example.com serves on port 25 (captured 2026-10-01T00:00:00.000Z) and none of them match it: pinned 2 0 1 eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee; served leaf SPKI SHA-256 bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, leaf SHA-256 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa. Where the RRset is DNSSEC-authenticated, DANE-validating clients reject the connection to this host. Republish the TLSA RRset from the current certificate (its issuer for DANE-TA) and automate the update on every rotation — a CDN-managed certificate rotates on the provider's schedule, so a hand-maintained DANE-EE pin drifts by default.",
    "metadata": {
      "capturedAt": "2026-10-01T00:00:00.000Z",
      "certificateMatchVerified": false,
      "name": "mail.example.com",
      "pinned": [
        "2 0 1 eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      ],
      "servedHost": "mail.example.com",
      "servedLeafSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "servedLeafSpkiSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "servedPort": 25,
      "subjectTerms": [
        "2 0 1 eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      ],
      "unmatchedAssociations": [
        "2 0 1 eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      ],
      "validRecordCount": 1,
    },
    "severity": "high",
    "title": "DANE TLSA pin does not match the served certificate for mail.example.com",
  },
]
`;

