exports[`checkDNSSEC output pin > DNSKEY SERVFAIL with an empty answer is an unmeasured leg, not an unsigned zone 1`] = `
{
  "calls": [
    "raw A example.com",
    "withRcode DNSKEY example.com",
    "withRcode DS example.com",
    "queryDNS NSEC3PARAM example.com",
  ],
  "result": {
    "category": "dnssec",
    "checkStatus": "error",
    "findings": [
      {
        "category": "dnssec",
        "detail": "The DNSKEY lookup for example.com did not complete, so the delegation linking the parent zone to the child's DNSSEC material could not be observed. The chain of trust is unverified for this run — this reflects the lookup, not the zone's configuration. Re-run to assess it.",
        "metadata": {
          "confidence": "heuristic",
          "errorKind": "dns_error",
          "inconclusive": true,
        },
        "severity": "info",
        "title": "DNSSEC chain of trust not assessable",
      },
    ],
    "partial": true,
    "passed": false,
    "score": 0,
  },
}
`;

