// TEST-ONLY config: cloudflareTest's `wrangler.configPath` loads this file (it cannot load a cf config). Deploy goes through cf:
// `npm -w packages/bv-ct-index run deploy` uses cloudflare.config.ts. Keep the two in sync (asserted by test/audits/infra-probe-wrangler.audit.test.ts).
// The D1 id below stays a placeholder: never paste the real id into a tracked file. Deploy reads it from BV_CT_INDEX_D1_ID
// (cloudflare.config.ts fails closed without it); remote migrations use a gitignored copy (see `npm run provision:ct-index`).
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "bv-ct-index",
	"main": "src/index.ts",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-07-29",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"upload_source_maps": true,
	// Compaction jobs need more than the 30 s default CPU (a first T3 merge reads a whole day of T2), and 5 min is the
	// queue-consumer maximum. It applies Worker-wide; the planner's job caps (src/indexer/plan.ts) keep T1/T2 jobs far below it.
	"limits": {
		"cpu_ms": 300000
	},
	"triggers": {
		// Tailer every minute; compactor hourly at :17.
		"crons": [
			"* * * * *",
			"17 * * * *"
		]
	},
	"r2_buckets": [
		{
			"binding": "INDEX",
			"bucket_name": "bv-ct-index"
		}
	],
	"d1_databases": [
		{
			"binding": "CURSORS",
			"database_name": "bv-ct-index-cursors",
			"database_id": "YOUR_BV_CT_INDEX_CURSORS_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "ENTRIES",
				"queue": "bv-ct-index-entries"
			},
			{
				"binding": "COMPACT",
				"queue": "bv-ct-index-compact"
			}
		],
		"consumers": [
			{
				// Contract v2: batch 100. Each indexer invocation writes exactly one T0 run (one R2 put), so a
				// bigger batch means fewer, larger runs.
				"queue": "bv-ct-index-entries",
				"max_batch_size": 100,
				"max_batch_timeout": 30,
				"max_retries": 3
			},
			{
				// One compaction job (one key range) per invocation, so each job gets the whole isolate.
				"queue": "bv-ct-index-compact",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3
			}
		]
	},
	"secrets": {
		"required": [
			"CT_INDEX_ADMIN_KEY"
		]
	},
	"observability": {
		"enabled": true
	}
}
