// Template for .dev/wrangler.deploy.jsonc — the PRIVATE OVERLAY, not a standalone config.
//
// scripts/inject-private-config.cjs merges this file onto the public wrangler.jsonc and
// writes wrangler.production.jsonc, which is what actually deploys. Only the keys below
// are merged: kv_namespaces, d1_databases, r2_buckets, analytics_engine_datasets,
// services, queues, vars. Everything else — name, main, compatibility_date,
// durable_objects, migrations, observability, limits, triggers, tail_consumers — is owned
// by wrangler.jsonc and is deliberately NOT repeated here. A copy kept here only goes
// stale: an earlier version of this template pinned an older `durable_objects` block and
// would have deployed without PROFILE_ACCUMULATOR.
{
	"kv_namespaces": [
		{ "binding": "RATE_LIMIT", "id": "YOUR_RATE_LIMIT_KV_NAMESPACE_ID" },
		{ "binding": "SCAN_CACHE", "id": "YOUR_SCAN_CACHE_KV_NAMESPACE_ID" },
		{ "binding": "SESSION_STORE", "id": "YOUR_SESSION_STORE_KV_NAMESPACE_ID" }
	],
	"analytics_engine_datasets": [
		{ "binding": "MCP_ANALYTICS", "dataset": "your_analytics_dataset" }
	],
	"queues": {
		"producers": [
			{ "binding": "BV_SCANNER_QUEUE", "queue": "bv-scanner-queue" }
		],
		"consumers": [
			{
				"queue": "bv-scanner-queue",
				"max_batch_size": 25,
				"max_retries": 3,
				// Create the DLQ first with `npx wrangler queues create bv-scanner-dlq`,
				// THEN add this field here and redeploy — see docs/tenant-ops-runbook.md's
				// "Dead-Letter Queue Setup" subsection. Without it, a message that exhausts
				// max_retries is dropped with no durable marker (SQ-169).
				"dead_letter_queue": "bv-scanner-dlq"
			}
		]
	},
	"vars": {
		// Set BV_API_KEY with `npx wrangler secret put BV_API_KEY`.
		"PROVIDER_SIGNATURES_URL": "",
		// The injector refuses to generate a production config without these three, and it
		// PINS OAUTH_ISSUER to the value below. A fork serving the Worker from a different
		// hostname must change REQUIRED_PRODUCTION_VARS in scripts/inject-private-config.cjs
		// to match its own origin — issued tokens are rejected as cross-issuer otherwise.
		// All three are fail-closed production gates; keep them as-is.
		"OAUTH_ISSUER": "https://dns-mcp.blackveilsecurity.com",
		"REJECT_QUERY_API_KEY": "true",
		"REQUIRE_PRODUCTION_BINDINGS": "true"
		// ALERT_WEBHOOK_URL is deliberately NOT a var here (#1073) — it is a capability
		// secret. Set it with:
		//   printf %s "https://your-alert-webhook" | npx wrangler secret put ALERT_WEBHOOK_URL --config .dev/wrangler.deploy.jsonc
		// scripts/inject-private-config.cjs fails the deploy closed unless
		// `wrangler secret list` shows it provisioned, and fails closed (a different
		// message) if it is ALSO present here as a var — a name cannot be both.
	}
}
